# Server-side Supabase configuration. For local values use npm run db:env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Planning Center personal access token for this single church organization.
# These values never belong in NEXT_PUBLIC_ variables.
PLANNING_CENTER_CLIENT_ID=
PLANNING_CENTER_SECRET=
PLANNING_CENTER_USER_AGENT=
# Optional comma-separated numeric Service Type IDs; blank means all accessible types.
PLANNING_CENTER_SERVICE_TYPE_IDS=
# Required for synchronization, YYYY-MM-DD. No historical date is assumed.
PLANNING_CENTER_SYNC_START_DATE=
